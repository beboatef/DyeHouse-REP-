{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<sql-host>;Database=DyeHouseERP;User Id=<sql-login>;Password=<sql-password>;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "DyeHouseERP",
    "Audience": "DyeHouseERP.Clients",
    "Key": "<set-in-user-secrets-or-Jwt__Key-environment-variable>"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
